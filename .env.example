# Public site settings
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_VERIFIED=false

# microCMS (server only: never rename these with NEXT_PUBLIC_)
MICROCMS_SERVICE_DOMAIN=your-service-id
MICROCMS_API_KEY=your-read-only-api-key
MICROCMS_SETTINGS_ENDPOINT=restaurant
MICROCMS_COURSES_ENDPOINT=courses
MICROCMS_NOTICES_ENDPOINT=notices
MICROCMS_REVALIDATE_SECONDS=300
MICROCMS_TIMEOUT_MS=5000
MICROCMS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Reservation email delivery (server only)
RESEND_API_KEY=re_xxxxxxxxxx
RESERVATION_FROM_EMAIL=KAGARI Reservations <reservations@example.com>

# Local development only. Ignored in production even when set to true.
RESERVATION_MOCK_MODE=false
